# D'Acqua Dolce canonical browser origin.
# Production must be the explicit public HTTPS origin.
DACQUA_PUBLIC_ORIGIN=http://127.0.0.1:5173

# Keep disabled until Postmark is intentionally configured.
DACQUA_EMAIL_PROVIDER=disabled

# Required when DACQUA_EMAIL_PROVIDER=postmark.
DACQUA_POSTMARK_SERVER_TOKEN=
DACQUA_EMAIL_FROM=
DACQUA_EMAIL_OPERATOR_TO=

DACQUA_PASSWORD_RESET_TTL_MINUTES=30
