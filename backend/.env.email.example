# D'Acqua Dolce local/development email example.
# Production uses the same mailbox roles with @dacquadolce.com instead of
# @dacquadolce.test and supplies real Postmark credentials/inbound routing.
DACQUA_ENVIRONMENT=development
DACQUA_PUBLIC_ORIGIN=http://127.0.0.1:15173

# Development/test email delivery stays suppressed by default.
DACQUA_EMAIL_PROVIDER=disabled

# Safe development/test company identities.
DACQUA_EMAIL_FROM=no-reply@dacquadolce.test
DACQUA_EMAIL_SUPPORT_FROM=support@dacquadolce.test
DACQUA_EMAIL_REPLY_FROM_ADDRESSES=sales@dacquadolce.test,contact@dacquadolce.test,info@dacquadolce.test,support@dacquadolce.test
DACQUA_EMAIL_SENDER_NAME="D'Acqua Dolce"

# Populate only when intentionally testing with Postmark.
DACQUA_POSTMARK_SERVER_TOKEN=
DACQUA_POSTMARK_INBOUND_ADDRESS=

# Optional internal/operator destination.
DACQUA_EMAIL_OPERATOR_TO=

DACQUA_PASSWORD_RESET_TTL_MINUTES=30
