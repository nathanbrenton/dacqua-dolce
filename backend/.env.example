DACQUA_ENVIRONMENT=development
DACQUA_DATABASE_URL=postgresql+psycopg://dacqua_dolce_app:replace-me@localhost:15432/dacqua_dolce_dev
DACQUA_SESSION_COOKIE_SECURE=false

# Development/test email stays local/suppressed by default. The backend derives
# the approved reply identities from DACQUA_ENVIRONMENT:
#   development/test -> @dacquadolce.test
#   production       -> @dacquadolce.com
DACQUA_EMAIL_PROVIDER=disabled
DACQUA_EMAIL_FROM=no-reply@dacquadolce.test
DACQUA_EMAIL_SUPPORT_FROM=support@dacquadolce.test
DACQUA_EMAIL_REPLY_FROM_ADDRESSES=sales@dacquadolce.test,contact@dacquadolce.test,info@dacquadolce.test,support@dacquadolce.test
DACQUA_EMAIL_SENDER_NAME="D'Acqua Dolce"

# PT35 approved launch geography: the 48 contiguous states plus Washington, DC.
# Alaska, Hawaii, Puerto Rico, and other U.S. territories are outside the
# initial launch area. Keep production runtime values aligned with this list;
# the Operations readiness audit flags drift from the approved launch policy.
DACQUA_SALES_AREA_MODE=allowlist
DACQUA_SALES_AREA_COUNTRY_CODE=US
DACQUA_SALES_AREA_REGION_CODES=AL,AR,AZ,CA,CO,CT,DC,DE,FL,GA,IA,ID,IL,IN,KS,KY,LA,MA,MD,ME,MI,MN,MO,MS,MT,NC,ND,NE,NH,NJ,NM,NV,NY,OH,OK,OR,PA,RI,SC,SD,TN,TX,UT,VA,VT,WA,WI,WV,WY
DACQUA_SALES_AREA_LABEL="the contiguous United States and Washington, DC"
