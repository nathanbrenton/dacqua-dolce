# Deploy-time PostgreSQL credential.
#
# Production path:
#   /etc/dacqua-dolce/migration.env
#
# Keep the production file root-owned and mode 0600.
# It must NOT be loaded by dacqua-dolce-api.service.

DACQUA_MIGRATION_DATABASE_URL=postgresql+psycopg://dacqua_dolce_migrator:CHANGE_ME@127.0.0.1:5432/dacqua_dolce
