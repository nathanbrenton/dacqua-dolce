# D'Acqua Dolce production backend environment template.
#
# Copy to a root-owned runtime secret file on the production host.
# Do NOT commit the populated file.

DACQUA_APP_NAME=D'Acqua Dolce
DACQUA_API_PREFIX=/api
DACQUA_ENVIRONMENT=production

# Canonical public HTTPS origin only.
# Never derive password-reset URLs from the Host header.
DACQUA_PUBLIC_ORIGIN=https://example.com

# PostgreSQL connection string.
# Use a dedicated non-superuser application role.
DACQUA_DATABASE_URL=postgresql+psycopg://dacqua_dolce_app:REPLACE_ME@127.0.0.1:5432/dacqua_dolce

# Session behavior.
DACQUA_SESSION_COOKIE_NAME=dacqua_session
DACQUA_SESSION_COOKIE_SECURE=true

# Transactional email.
DACQUA_EMAIL_PROVIDER=postmark
DACQUA_POSTMARK_SERVER_TOKEN=REPLACE_ME
DACQUA_EMAIL_FROM=REPLACE_ME
DACQUA_EMAIL_OPERATOR_TO=REPLACE_ME
DACQUA_PASSWORD_RESET_TTL_MINUTES=30
