# D'Acqua Dolce production backend environment template.
#
# Install the populated production copy as:
#
#   /etc/dacqua-dolce/backend.env
#
# Replace every REPLACE_* value before enabling the API.
# Never commit the populated production file.

DACQUA_ENVIRONMENT=production

DACQUA_DATABASE_URL=postgresql+psycopg://dacqua_dolce_app:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/dacqua_dolce

DACQUA_SESSION_COOKIE_SECURE=true
DACQUA_SESSION_COOKIE_SAMESITE=lax
DACQUA_CSRF_PROTECTION_ENABLED=true

# Generate a unique production Fernet key.
DACQUA_MFA_ENCRYPTION_KEY=REPLACE_FERNET_KEY

DACQUA_SECURITY_HSTS_ENABLED=true
DACQUA_SECURITY_HSTS_MAX_AGE_SECONDS=31536000
DACQUA_SECURITY_HSTS_INCLUDE_SUBDOMAINS=false

DACQUA_PUBLIC_ORIGIN=https://REPLACE_CANONICAL_HOSTNAME

# Keep disabled until Postmark and DNS are ready.
DACQUA_EMAIL_PROVIDER=disabled
DACQUA_POSTMARK_SERVER_TOKEN=REPLACE_POSTMARK_SERVER_TOKEN
DACQUA_EMAIL_FROM=no-reply@REPLACE_CANONICAL_HOSTNAME
# Employee/customer conversation replies use a human-facing sender while
# thread routing stays in Reply-To and must never be exposed in the UI.
DACQUA_EMAIL_SUPPORT_FROM=support@REPLACE_CANONICAL_HOSTNAME
DACQUA_EMAIL_OPERATOR_TO=REPLACE_OPERATOR_EMAIL
